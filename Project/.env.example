# ---------------------------------------------
# PotBuddy Local Node Configuration
# ---------------------------------------------
# Overrides properties set inside config.yaml 

# The unique identifier for this gateway/area
DEVICE_ID=esp32wroom-project

# Cloud telemetry external broker authentication (if required)
CLOUD_MQTT_USER=
CLOUD_MQTT_PASS=

# ---------------------------------------------
# Database Connection (Used by Both Services)
# ---------------------------------------------
# Standard Postgres Connection String for tracking node schemas and health profiles.
# Format: postgres://username:password@host:port/database?sslmode=disable
DB_DSN=postgres://postgres:postgres@10.0.0.66:5432/potbuddy?sslmode=disable

# ---------------------------------------------
# Manager API & UI Dashboard Configuration
# ---------------------------------------------
# The port where the React Frontend and Management JSON API are natively hosted.
PORT=8081

# Google OAuth Client ID (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Secret used to sign JWT session tokens (Change in production!)
JWT_SECRET=dev-secret-keep-it-safe
